<ContentPage
    x:Class="SearchViewClone.Search.Scopes.OverlayPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SearchViewClone.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="700"
    x:DataType="vm:OverlayViewModel"
    Header="Overlay">

    <DockPanel>
        <TextBlock
            DockPanel.Dock="Top"
            Margin="24 18 24 0"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Overlay" />

        <TextBox
            x:Name="InputBox"
            DockPanel.Dock="Top"
            Margin="24 12 24 0"
            VerticalAlignment="Top"
            FontSize="16"
            PlaceholderText="Type here"
            Text="{Binding Text}" />

        <ScrollViewer
            x:Name="ContentScrollViewer"
            Focusable="True"
            Margin="0 12 0 0">
            <StackPanel />
        </ScrollViewer>
    </DockPanel>
</ContentPage>
